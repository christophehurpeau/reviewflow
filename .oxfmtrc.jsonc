{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortPackageJson": { "sortScripts": true },
  "ignorePatterns": [
    "/packages/*/build",
    "/packages/*/.expo/",
    "/packages/*/android/",
    "/packages/*/ios/",
    "/packages/*/dist/",
    "/packages/*/dist-native/",
    "*.jks",
    "*.p8",
    "*.p12",
    "*.key",
    "*.mobileprovision",
    "*.orig.*",
    "*.icon/",
    "CHANGELOG.md",
  ],
}

# The ID of your GitHub App
APP_ID=
WEBHOOK_SECRET=development

PRIVATE_KEY_PATH="private_key/private-key.pem"

# Use `trace` to get verbose logging or `info` to show less
LOG_LEVEL=debug

PORT=3001

# /api/internal listens apart from PORT, on the loopback interface only
INTERNAL_API_PORT=3002
INTERNAL_API_HOST=127.0.0.1

# shared secret protecting /api/internal, must match the webapp server
INTERNAL_API_SECRET=development

REVIEWFLOW_NAME=reviewflow-dev

# base url of the webapp, linked from slack messages and pr bodies
REVIEWFLOW_APP_URL="http://localhost:8081"

# mongo
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=reviewflow

# Go to https://smee.io/new set this to the URL that you are redirected to.
WEBHOOK_PROXY_URL=

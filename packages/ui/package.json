{
  "name": "@reviewflow/ui",
  "version": "6.29.0",
  "description": "react-native pull request screen components. Consumed as SOURCES (no build): exports resolve `default` to ./src/index.ts, which metro transforms like the app's own files; the consuming app's css must @source this package's src so tailwind keeps its classes.",
  "keywords": [
    "alouette",
    "code-review",
    "expo",
    "github",
    "pull-request",
    "react-native",
    "reviewflow"
  ],
  "homepage": "https://github.com/christophehurpeau/reviewflow",
  "bugs": {
    "url": "https://github.com/christophehurpeau/reviewflow/issues"
  },
  "license": "ISC",
  "author": "Christophe Hurpeau <302891+christophehurpeau@users.noreply.github.com> (https://christophe.hurpeau.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/reviewflow.git",
    "directory": "packages/ui"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.stories.tsx",
    "!src/stories",
    "!src/board/fixtures.ts",
    "!src/board/mockDataSource.tsx"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./diff-viewer": {
      "types": "./src/components/diff-viewer.tsx",
      "default": "./src/components/diff-viewer.tsx"
    },
    "./diff-worker-pool": {
      "types": "./src/components/branch-diff/diff-worker-pool.tsx",
      "browser": "./src/components/branch-diff/diff-worker-pool.web.tsx",
      "default": "./src/components/branch-diff/diff-worker-pool.tsx"
    },
    "./palette": {
      "types": "./src/palette.ts",
      "default": "./src/palette.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:code-theme": "node build-code-theme.ts",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:eslint": "pnpm --dir '../..' exec eslint --quiet 'packages/ui'",
    "lint:oxlint": "pnpm --dir '../..' exec oxlint --quiet 'packages/ui'",
    "tsc": "tsc"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/common": "1.5.5",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.7.2",
    "@pierre/diffs": "1.5.2",
    "@pierre/trees": "1.0.0-beta.6",
    "@reviewflow/sdk": "workspace:*",
    "@tanstack/markdown": "0.0.13",
    "alouette-icons": "12.0.0",
    "gemoji": "8.1.0",
    "htmlparser2": "12.0.0"
  },
  "devDependencies": {
    "@pierre/theme": "2.0.0",
    "@storybook/react-native": "10.6.0",
    "@types/react": "19.2.18",
    "@typescript/native": "npm:typescript@7.0.2",
    "alouette": "25.0.1",
    "colorjs.io": "0.6.0-alpha.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.8.0",
    "react-native-svg": "15.15.5",
    "storybook": "10.6.6",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "peerDependencies": {
    "alouette": "^25.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "*",
    "react-native-svg": "*"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}

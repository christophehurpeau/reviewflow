{
  "name": "webapp",
  "version": "1.0.0-pre",
  "private": true,
  "homepage": "https://github.com/christophehurpeau/reviewflow",
  "license": "UNLICENSED",
  "author": "Christophe Hurpeau <302891+christophehurpeau@users.noreply.github.com> (https://christophe.hurpeau.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/reviewflow.git",
    "directory": "packages/webapp"
  },
  "type": "module",
  "main": "expo-router/entry",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "expo export --platform web --output-dir dist",
    "lint": "pnpm run lint:eslint",
    "lint:eslint": "pnpm run --dir '../..' eslint --quiet 'packages/webapp'",
    "serve": "npx serve dist",
    "start": "expo start --web",
    "tsc": "tsc",
    "upgrade-expo": "expo install expo@57 --fix"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.9",
    "alouette": "22.5.1",
    "alouette-icons": "11.1.0",
    "expo": "57.0.12",
    "expo-constants": "57.0.10",
    "expo-linking": "57.0.5",
    "expo-router": "57.0.12",
    "expo-web-browser": "57.0.2",
    "lightningcss": "1.33.0",
    "liwi-resources-client": "13.1.1",
    "liwi-resources-void-client": "13.1.1",
    "liwi-resources-websocket-client": "13.1.1",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-liwi": "13.1.1",
    "react-native": "0.86.2",
    "react-native-css": "3.0.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.3",
    "reviewflow-modules": "workspace:*",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@react-native/metro-config": "0.86.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}

{
  "extends": [
    "@pob/root/tsconfigs/strict.json",
    "@pob/root/tsconfigs/targets/expo.json"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "./*.ts",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/tsbuildinfo",
    "incremental": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "paths": {
      "#/*": ["./src/*"],
      "reviewflow-modules": ["../../packages/reviewflow-modules/lib"],
      "reviewflow-modules/*": ["../../packages/reviewflow-modules/lib/*"]
    }
  }
}

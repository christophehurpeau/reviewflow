# Only needed in development, when the webapp runs on the expo dev server and
# the reviewflow webapp server on another port. In production that server serves
# this app, so both are the same origin and these are left unset.
EXPO_PUBLIC_SERVER_URL=http://localhost:3000
EXPO_PUBLIC_WS_URL=ws://localhost:3000/ws

# name of the github app, used to build the installation links
EXPO_PUBLIC_REVIEWFLOW_NAME=reviewflow-dev

{
  "extends": [
    "@pob/root/tsconfigs/strict.json",
    "@pob/root/tsconfigs/targets/rollup-node-24.json"
  ],
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "node_modules/.cache/tsc",
    "tsBuildInfoFile": "node_modules/.cache/tsc/tsbuildinfo",
    "noEmitOnError": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "incremental": true,
    "composite": true,

    "resolveJsonModule": true,

    "paths": {
      "reviewflow-modules": ["../../packages/reviewflow-modules/lib"],
      "reviewflow-modules/*": ["../../packages/reviewflow-modules/lib/*"]
    }
  }
}

{
  "name": "reviewflow-core",
  "version": "6.4.0",
  "private": true,
  "description": "mongo stores, models and account configs shared by the reviewflow servers",
  "homepage": "https://github.com/christophehurpeau/reviewflow",
  "license": "ISC",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (https://christophe.hurpeau.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/reviewflow.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./build/index-node.mjs",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "node": {
        "import": "./build/index-node.mjs"
      }
    }
  },
  "scripts": {
    "build": "pnpm run clean:build && rollup --config rollup.config.mjs",
    "clean": "pnpm run clean:build",
    "clean:build": "pob-esbuild-clean-out build",
    "lint": "pnpm run lint:eslint",
    "lint:eslint": "pnpm run --dir '../..' eslint --quiet 'packages/core'",
    "start": "pnpm run clean:build && rollup --config rollup.config.mjs --watch",
    "test": "pnpm run --dir '../..' test -- 'packages/core'",
    "tsc": "tsc",
    "watch": "pnpm run clean:build && rollup --config rollup.config.mjs --watch"
  },
  "dependencies": {
    "emoji-regex": "10.6.0",
    "gemoji": "8.1.0",
    "liwi-mongo": "13.1.1",
    "liwi-store": "13.1.1",
    "reviewflow-modules": "workspace:*"
  },
  "devDependencies": {
    "@octokit/rest": "22.0.1",
    "@pob/rollup-esbuild": "10.0.0",
    "@slack/web-api": "8.0.0",
    "@types/node": "24.12.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "pob": {
    "bundler": "rollup-esbuild",
    "entries": [
      "index"
    ],
    "envs": [
      {
        "target": "node",
        "version": "24",
        "omitVersionInFileName": true
      }
    ],
    "typescript": true
  }
}

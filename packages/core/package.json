{
  "name": "@reviewflow/core",
  "version": "6.29.0",
  "private": true,
  "description": "mongo stores, models and account configs shared by the reviewflow servers",
  "homepage": "https://github.com/christophehurpeau/reviewflow",
  "license": "ISC",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (https://christophe.hurpeau.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/reviewflow.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./build/index-node.mjs",
  "types": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./src/index.ts",
      "node": {
        "import": "./build/index-node.mjs"
      }
    }
  },
  "scripts": {
    "build": "pnpm run clean:build && rollup --config rollup.config.mjs",
    "clean": "pnpm run clean:build",
    "clean:build": "pob-esbuild-clean-out build",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:eslint": "pnpm --dir '../..' exec eslint --quiet 'packages/core'",
    "lint:oxlint": "pnpm --dir '../..' exec oxlint --quiet 'packages/core'",
    "start": "pnpm run clean:build && rollup --config rollup.config.mjs --watch",
    "test": "pnpm run --dir '../..' test -- 'packages/core'",
    "tsc": "tsrs",
    "tsc:go": "tsc",
    "watch": "pnpm run clean:build && rollup --config rollup.config.mjs --watch"
  },
  "dependencies": {
    "@reviewflow/modules": "workspace:*",
    "@sentry/node": "11.8.0",
    "emoji-regex": "10.6.0",
    "gemoji": "8.1.0",
    "liwi-mongo": "15.0.0",
    "liwi-store": "14.1.0",
    "mingo": "7.2.7",
    "nightingale": "18.2.0",
    "nightingale-logger": "18.2.0",
    "nightingale-sentry": "18.2.0"
  },
  "devDependencies": {
    "@octokit/rest": "22.0.1",
    "@pob/rollup-esbuild": "11.4.0",
    "@slack/web-api": "8.0.0",
    "@types/node": "24.12.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "tsrs": "0.22.0-ts7.1.0-beta",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^24.22.1 || >=26.13.0"
  },
  "pob": {
    "bundler": "rollup-esbuild",
    "entries": [
      "index"
    ],
    "envs": [
      {
        "target": "node",
        "version": "24",
        "omitVersionInFileName": true
      }
    ],
    "typescript": true
  }
}

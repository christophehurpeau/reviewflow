PORT=3000

# base url of the webapp: the expo dev server in development, this server in production
REVIEWFLOW_APP_URL="http://localhost:8081"
REVIEWFLOW_NAME=reviewflow-dev

# where the webhook server serves /api/internal, and the secret it expects
BOT_INTERNAL_URL="http://127.0.0.1:3002"
INTERNAL_API_SECRET=development

# mongo
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=reviewflow

# github auth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_SECRET_KEY=

# set to true behind https, the auth cookie is then only sent on secure requests
SECURE_COOKIE=

# slack auth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

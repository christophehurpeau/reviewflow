PORT=3000

# Sentry: errors are reported when set, nothing is sent otherwise
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# base url of the webapp: the expo dev server in development, this server in production
REVIEWFLOW_APP_URL="http://localhost:8081"
REVIEWFLOW_NAME=reviewflow-dev

# where the webhook server serves /api/internal, and the secret it expects
BOT_INTERNAL_URL="http://127.0.0.1:3002"
INTERNAL_API_SECRET=development

# "true" switches off the relay of the bot's writes to the webapp server: set it
# on both servers. The webapp then only updates live on its own writes
STORE_RELAY_DISABLED=

# mongo
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=reviewflow

# github auth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_SECRET_KEY=

# set to true behind https, the auth cookie is then only sent on secure requests
SECURE_COOKIE=

# the reverse proxy express may trust for the caller's ip (X-Forwarded-For):
# "loopback" for a proxy on the same host. Empty: no proxy
TRUST_PROXY=

# live subscriptions past these limits degrade to a single fetch (no live
# update). Empty: 1000 in total, 45 per user (a board tab holds 9)
MAX_LIVE_SUBSCRIPTIONS=
MAX_LIVE_SUBSCRIPTIONS_PER_USER=

# github user ids (comma-separated) allowed to enable the paid features (live
# updates, read API) per account from the admin screen. Empty: no admin.
# Numeric ids, not logins, e.g.:
# REVIEWFLOW_ADMIN_USER_IDS=123456,7890123
REVIEWFLOW_ADMIN_USER_IDS=

# slack auth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

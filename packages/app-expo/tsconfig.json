{
  "extends": [
    "@pob/root/tsconfigs/strict.json",
    "@pob/root/tsconfigs/targets/expo.json"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "./*.ts",
    ".storybook/*.ts",
    ".storybook/*.tsx",
    ".storybook-web/*.ts",
    ".storybook-web/*.tsx",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/tsbuildinfo",
    "incremental": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "paths": {
      "#/*": ["./src/*"],
      "@reviewflow/sdk": ["../../packages/sdk/src"],
      "@reviewflow/sdk/*": ["../../packages/sdk/src/*"],
      "@reviewflow/ui": ["../../packages/ui/src"],
      "@reviewflow/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "references": [
    {
      "path": "../../packages/sdk/tsconfig.json"
    },
    {
      "path": "../../packages/ui/tsconfig.json"
    }
  ]
}

{
  "name": "@reviewflow/app-expo",
  "version": "6.24.0",
  "private": true,
  "description": "Expo Router app that opens any GitHub pull request on its local server (@reviewflow/app): conversation, checks, commits and the git diff.",
  "homepage": "https://github.com/christophehurpeau/reviewflow",
  "license": "ISC",
  "author": "Christophe Hurpeau <302891+christophehurpeau@users.noreply.github.com> (https://christophe.hurpeau.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/reviewflow.git",
    "directory": "packages/app-expo"
  },
  "type": "module",
  "main": "./src/AppEntry.tsx",
  "imports": {
    "#/*": "./src/*",
    "#storybook/*": "./.storybook/*"
  },
  "scripts": {
    "build": "expo export --platform web --output-dir dist",
    "build:theme": "node build-theme.ts",
    "clean": "rm -rf dist",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:eslint": "pnpm --dir '../..' exec eslint --quiet 'packages/app-expo'",
    "lint:oxlint": "pnpm --dir '../..' exec oxlint --quiet 'packages/app-expo'",
    "start": "expo start --web --port 8085",
    "tsc": "tsrs",
    "tsc:go": "tsc",
    "upgrade-expo": "expo install expo@57 --fix"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.9",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@reviewflow/sdk": "workspace:*",
    "@reviewflow/ui": "workspace:*",
    "@storybook/react-native": "10.6.0",
    "@tanstack/react-query": "5.104.2",
    "alouette": "25.0.1",
    "alouette-icons": "12.0.0",
    "expo": "57.0.12",
    "expo-clipboard": "57.0.2",
    "expo-constants": "57.0.10",
    "expo-linking": "57.0.5",
    "expo-router": "57.0.12",
    "expo-web-browser": "57.0.2",
    "lightningcss": "1.33.0",
    "nativewind": "5.0.0-rc.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-css": "3.1.0-rc.0",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.3",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.5",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.2",
    "@react-native/metro-config": "0.86.2",
    "@storybook/addon-ondevice-actions": "10.6.0",
    "@storybook/addon-ondevice-controls": "10.6.0",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react": "10.6.5",
    "@storybook/react-native-web-vite": "10.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.63.0",
    "storybook": "10.6.5",
    "tsrs": "0.22.0-ts7.1.0-beta",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.13.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}

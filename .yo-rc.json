{
  "pob": {
    "project": {
      "type": "app",
      "packageManager": "pnpm",
      "ci": true
    },
    "renovate": {
      "enable": true
    },
    "monorepo": {
      "ci": true,
      "disablePushWorkflow": false,
      "testing": true,
      "testRunner": "vitest",
      "e2eTesting": false,
      "codecov": false,
      "typescript": true,
      "eslint": true,
      "packageNames": [
        "reviewflow-modules",
        "reviewflow-core",
        "webapp",
        "reviewflow",
        "reviewflow-webapp-server"
      ]
    }
  }
}

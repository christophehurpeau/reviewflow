{
  "pob": {
    "project": {
      "type": "app",
      "packageManager": "pnpm",
      "ci": true
    },
    "renovate": {
      "enable": true
    },
    "monorepo": {
      "storybook": true,
      "storybookReactNative": true,
      "ci": true,
      "disablePushWorkflow": false,
      "testing": true,
      "testRunner": "vitest",
      "e2eTesting": false,
      "codecov": false,
      "typescript": true,
      "eslint": true,
      "packageNames": [
        "@reviewflow/modules",
        "@reviewflow/sdk",
        "@reviewflow/app",
        "@reviewflow/core",
        "@reviewflow/ui",
        "@reviewflow/webapp",
        "@reviewflow/app-expo",
        "@reviewflow/reviewflow",
        "@reviewflow/webapp-server"
      ],
      "mongodbBinaryCacheKeyFile": "scripts/vitestMongoGlobalSetup.ts"
    }
  }
}

{
  "name": "reviewflow-monorepo",
  "version": "6.29.0",
  "private": true,
  "homepage": "https://github.com/christophehurpeau/reviewflow",
  "bugs": {
    "url": "https://github.com/christophehurpeau/reviewflow/issues"
  },
  "license": "ISC",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (https://christophe.hurpeau.com)",
  "repository": "https://github.com/christophehurpeau/reviewflow.git",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "dev": "pnpm -r --parallel --filter @reviewflow/modules --filter @reviewflow/core --filter @reviewflow/reviewflow --filter @reviewflow/webapp-server run start",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "lint": "pnpm run format && pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:eslint": "eslint --quiet .",
    "lint:oxlint": "oxlint --quiet",
    "prepare": "pob-root-postinstall",
    "test": "TZ=UTC vitest",
    "test:coverage": "TZ=UTC POB_VITEST_COVERAGE=json,text vitest run --coverage",
    "test:coverage:generate": "TZ=UTC POB_VITEST_COVERAGE=json vitest run --coverage",
    "test:watch": "TZ=UTC vitest --watch",
    "tsc": "tsrs -b",
    "tsc:go": "tsc -b",
    "watch": "pnpm -r --parallel --filter \"!*-example\" run watch"
  },
  "devDependencies": {
    "@pob/eslint-config": "68.4.0",
    "@pob/eslint-config-typescript-react": "68.5.0",
    "@pob/root": "28.7.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "mongodb-memory-server": "11.3.0",
    "tsrs": "0.22.0-ts7.1.0-beta",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "commitlint": {
    "extends": [
      "@pob/root/commitlint-config"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": "^24.22.1 || >=26.13.0",
    "pnpm": ">= 12.0.0"
  }
}
